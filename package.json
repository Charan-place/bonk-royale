{
  "name": "bonk-royale",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bonk Royale: flick-sumo party brawler with friends, parties and 1v1 duels on Cloudflare",
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "dev": "wrangler dev",
    "deploy": "vite build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply bonk-db --local",
    "db:remote": "wrangler d1 migrations apply bonk-db --remote",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.1.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  }
}
